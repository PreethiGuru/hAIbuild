VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0674186193.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0674186193"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0674186193.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="673509007608"
VITE_FIREBASE_APP_ID="1:673509007608:web:12efd4dab8845efbaddb0d"
