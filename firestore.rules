rules_version = '2';

// Hackathon-scope rules: no auth wired up yet, so this is open by device-generated ID,
// not identity-verified. No PII is stored here (gamification/progress data only).
// Tighten this (e.g. Firebase Anonymous Auth + request.auth.uid == uid) before any real launch.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if true;

      match /dailyProgress/{date} {
        allow read, write: if true;
      }
    }

    // Written only by the trusted BigQuery pipeline scripts (Firebase Admin
    // SDK, which bypasses these rules entirely) -- the client only ever reads.
    match /trends/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
